# PhiGate configuration — copy to .env and `set -a; source .env; set +a` before `make run`.
#
# Only PHIGATE_API_KEYS and PHIGATE_CLOUD_API_KEY are required. Everything else
# has a production-safe default; the values below are those defaults, shown so
# you can see what is in force without reading the source.

# ============================================================ gateway
PHIGATE_ADDR=:8080

# ============================================================ access control
# REQUIRED. Format: "key:tenant,key:tenant". The tenant label appears in audit
# records and drives per-tenant rate limiting.
#
# PhiGate refuses to start without this unless PHIGATE_ALLOW_ANONYMOUS is set.
# An unauthenticated gateway in front of a billed API key is an open relay:
# anyone who can reach the port can spend your upstream quota.
PHIGATE_API_KEYS=change-me-client-key:team-sre

# PHIGATE_ALLOW_ANONYMOUS=false
# PHIGATE_RATE_LIMIT_PER_MIN=0
# PHIGATE_RATE_LIMIT_BURST=0
# Set ONLY if a proxy you control sets it. Trusting X-Forwarded-For blindly
# lets any client forge the address recorded in your audit log.
# PHIGATE_TRUSTED_PROXY_HEADER=

# ============================================================ local SLM
# Ollama / llama.cpp / vLLM — anything speaking the OpenAI protocol.
PHIGATE_LOCAL_PROVIDER=openai
PHIGATE_LOCAL_BASE_URL=http://localhost:11434/v1
# Must match `ollama list` exactly (it may be phi4-mini:latest).
PHIGATE_LOCAL_MODEL=phi4-mini
PHIGATE_LOCAL_API_KEY=

# ============================================================ cloud LLM
PHIGATE_CLOUD_PROVIDER=openai
PHIGATE_CLOUD_BASE_URL=https://api.openai.com/v1
# gpt-4o-mini keeps evaluation cost near zero; swap for gpt-4o for quality.
PHIGATE_CLOUD_MODEL=gpt-4o-mini
PHIGATE_CLOUD_API_KEY=sk-replace-me

# --- Azure OpenAI instead (the deployment most JP enterprises actually have):
# PHIGATE_CLOUD_PROVIDER=azure
# PHIGATE_CLOUD_BASE_URL=https://your-resource.openai.azure.com
# PHIGATE_CLOUD_API_VERSION=2024-10-21
# PHIGATE_CLOUD_DEPLOYMENT=your-gpt4o-deployment
# PHIGATE_CLOUD_API_KEY=your-azure-key

# ============================================================ egress policy
# The highest classification permitted to reach a CLOUD provider:
#   low | internal | confidential | restricted
#
# Default "internal": masked topology may leave; personal data and credentials
# may not. Data above the limit is confined to the local model and does NOT
# fall back to the cloud if the local model fails — it fails instead.
PHIGATE_CLOUD_MAX_SENSITIVITY=internal

# Refuse such requests outright rather than confining them. Empty = never.
# PHIGATE_DENY_ABOVE_SENSITIVITY=

# Applies only to payloads already cleared for cloud egress.
PHIGATE_ALLOW_CLOUD_FALLBACK=true

# ============================================================ redaction
# Empty = all built-in packs (core, jp, secrets). Run `phigate -rules` to list
# every rule and its classification.
# PHIGATE_REDACT_PACKS=

# Hostname suffixes to treat as internal topology. Site-specific, so opt-in.
PHIGATE_INTERNAL_DOMAINS=internal,corp,local,lan,intra

# Your own *.json rule packs — employee IDs, project codenames, customer refs.
# PHIGATE_REDACT_RULE_DIR=/etc/phigate/rules

# Built-in rules to switch off, by name.
# PHIGATE_REDACT_DISABLE=

# The entropy detector catches credential formats no pattern anticipated.
# Turning it off narrows protection to known patterns only.
PHIGATE_REDACT_DISABLE_ENTROPY=false

# ============================================================ guardrails
# Per-rule severity overrides: rule=info|warn|block
# e.g. block reboots in a change-controlled environment:
# PHIGATE_GUARD_SEVERITY=host_power_state=block,sql_truncate=warn

PHIGATE_INGRESS_SCAN=true

# ============================================================ sessions + cache
# Send X-PhiGate-Session: <conversation-id> so the same value maps to the same
# placeholder across the turns of a conversation.
PHIGATE_SESSION_TTL=30m
PHIGATE_SESSION_MAX=10000
PHIGATE_SESSION_HEADER=X-PhiGate-Session

# The template cache is the single largest cost saving: identical compressed
# templates are answered with zero upstream tokens. It stores pre-hydration
# text only, so it holds no customer data.
PHIGATE_CACHE_ENABLED=true
PHIGATE_CACHE_TTL=15m
PHIGATE_CACHE_MAX=5000

# ============================================================ accounting
# Your negotiated rates and currency — list prices in USD are rarely what an
# enterprise actually pays. See deploy/price-book.example.json.
# PHIGATE_PRICE_BOOK=/etc/phigate/price-book.json

# Amortised cost per million tokens of local inference. 0 treats the marginal
# cost of an already-running Ollama as zero.
PHIGATE_LOCAL_COST_PER_MTOK=0

# ============================================================ observability
# Empty = structured JSON to stderr for your log pipeline to collect.
# PHIGATE_AUDIT_LOG=/var/log/phigate/audit.jsonl
PHIGATE_AUDIT_DISABLED=false
PHIGATE_METRICS_PATH=/metrics
PHIGATE_DASHBOARD=true

# ⚠️  /debug/compress returns the PLAINTEXT of every masked value.
# Never enable this in production.
PHIGATE_DEBUG=false

# ============================================================ serving
PHIGATE_READ_HEADER_TIMEOUT=10s
PHIGATE_READ_TIMEOUT=60s
# 0 = unbounded. A streaming completion may legitimately outlast any fixed
# bound, and cutting one off mid-answer is worse than the risk it mitigates.
PHIGATE_WRITE_TIMEOUT=0
PHIGATE_IDLE_TIMEOUT=120s
PHIGATE_SHUTDOWN_GRACE=20s
PHIGATE_MAX_BODY_BYTES=4194304
PHIGATE_UPSTREAM_RETRIES=2
PHIGATE_BREAKER_THRESHOLD=5
PHIGATE_BREAKER_COOLDOWN=30s
