# PhiGate configuration — copy to .env and `set -a; source .env; set +a` before `make run`.
# Only PHIGATE_CLOUD_API_KEY is strictly required; everything else has a default.

# --- Gateway ---
PHIGATE_ADDR=:8080

# --- Local SLM (Ollama / llama.cpp, OpenAI-compatible) ---
PHIGATE_LOCAL_BASE_URL=http://localhost:11434/v1
# Must match `ollama list` exactly (could be phi4-mini:latest).
PHIGATE_LOCAL_MODEL=phi4-mini
# Ollama ignores the key; leave empty.
PHIGATE_LOCAL_API_KEY=

# --- Cloud LLM (OpenAI-compatible) ---
PHIGATE_CLOUD_BASE_URL=https://api.openai.com/v1
# gpt-4o-mini keeps test cost minimal; swap for gpt-4o for quality.
PHIGATE_CLOUD_MODEL=gpt-4o-mini
PHIGATE_CLOUD_API_KEY=sk-replace-me
